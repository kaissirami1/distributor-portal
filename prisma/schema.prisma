generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Submission {
  id           Int      @id @default(autoincrement())
  name         String
  email        String
  phone        String? 
  companyName  String?
  productName  String
  category     String?
  cost         String?
  minimumOrder String?
  city         String?
  county       String?
  notes        String?
  productUrl   String?
  documentsUrl String?
  barcode      String?
  imageUrl     String?
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  trackingId String? @unique

  reviewNotes  ReviewNote[]
  statusEvents StatusEvent[]
  sales        Sale[]
  documents    Document[]
}
model ReviewNote {
  id           Int        @id @default(autoincrement())
  content      String
  author       String     @default("Admin")   // ← add this line
  createdAt    DateTime   @default(now())

  submissionId Int
  submission   Submission @relation(fields: [submissionId], references: [id])
}
model StatusEvent {
  id           Int        @id @default(autoincrement())
  fromStatus   String
  toStatus     String
  createdAt    DateTime   @default(now())

  submissionId Int
  submission   Submission @relation(fields: [submissionId], references: [id])
}
model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  image       String?
  origin      String
  createdAt   DateTime @default(now())
}
// A sale of either a vendor's product (submission) or one of our own inventory items
model Sale {
  id              Int            @id @default(autoincrement())
  quantity        Int
  revenue         Float
  note            String?
  createdAt       DateTime       @default(now())

  submissionId    Int?
  submission      Submission?    @relation(fields: [submissionId], references: [id])
  inventoryItemId Int?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  // Who bought it and whether they've paid (see Admin → Payments)
  storeId         Int?
  store           Store?         @relation(fields: [storeId], references: [id], onDelete: SetNull)
  invoiceNumber   String?
  dueDate         DateTime?
  paidAt          DateTime?
  paymentMethod   String?
}

// Paperwork a seller sends us: food license, FDA registration, insurance, etc.
// The kinds of documents are listed in lib/documents.ts.
model Document {
  id           Int        @id @default(autoincrement())
  type         String
  url          String?
  fileName     String?
  value        String?
  uploadedBy   String     @default("seller")
  createdAt    DateTime   @default(now())

  submissionId Int
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

// Every admin login attempt, used to pause logins after too many wrong passwords
model LoginAttempt {
  id        Int      @id @default(autoincrement())
  username  String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Products we buy and hold ourselves. Units and reasons are listed in lib/inventory.ts.
model InventoryItem {
  id         Int      @id @default(autoincrement())
  name       String
  sku        String?
  supplier   String?  // old free-text supplier; new items pick a Seller instead
  unit       String   @default("case")
  caseBarcode    String?  // the barcode printed on the case
  casesPerPallet Int?     // lets stock be shown and received in pallets
  sellerId       Int?
  seller         Seller?  @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  quantity   Int      @default(0)
  cost       Float    @default(0)
  price      Float    @default(0)
  lowStockAt Int?
  location   String?
  notes      String?
  image      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  movements  InventoryMovement[]
  sales      Sale[]
  orderLines PurchaseOrderLine[]
}

// Every change to an item's stock: received, sold, removed, corrected
model InventoryMovement {
  id        Int           @id @default(autoincrement())
  change    Int
  reason    String
  note      String?
  author    String?
  createdAt DateTime      @default(now())
  batch     String?       // batch / lot number from the seller (when receiving)
  unitCost  Float?        // what we paid per case for this delivery
  pallets   Int?          // received as this many pallets

  itemId    Int
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

// Stores we visit and sell to. Stages, store types and roles are listed in lib/stores.ts.
model Store {
  id          Int          @id @default(autoincrement())
  name        String
  type        String?
  address     String?
  city        String?
  phone       String?
  email       String?
  website     String?
  contactName String?
  contactRole String?
  stage       String       @default("new")
  nextStep    String?
  followUpOn  DateTime?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  visits      StoreVisit[]
  sales       Sale[]
}

// Every visit, call or message with a store
model StoreVisit {
  id            Int      @id @default(autoincrement())
  date          DateTime @default(now())
  kind          String   @default("visit")
  spokeWith     String?
  spokeWithRole String?
  decisionMaker Boolean  @default(false)
  samplesGiven  String?
  outcome       String?
  notes         String?
  author        String?
  createdAt     DateTime @default(now())

  storeId       Int
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

// Money we owe: sellers, the warehouse, freight, anything else (see Admin → Payments)
model Bill {
  id            Int       @id @default(autoincrement())
  payee         String
  description   String?
  amount        Float
  dueDate       DateTime?
  paidAt        DateTime?
  paymentMethod String?
  reference     String?
  notes         String?
  author        String?
  createdAt     DateTime  @default(now())

  purchaseOrder PurchaseOrder? // when this bill came from a purchase order
}

// The people and companies we buy inventory from (Admin → Inventory → Sellers)
model Seller {
  id          Int             @id @default(autoincrement())
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  website     String?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  items          InventoryItem[]
  purchaseOrders PurchaseOrder[]
}

// Orders we place with a seller (Admin → Inventory → Purchase orders).
// The seller ships to our 3PL; when it arrives, the stock is added and a bill is made in Payments.
model PurchaseOrder {
  id          Int       @id @default(autoincrement())
  status      String    @default("draft") // draft, sent, confirmed, shipped, received, cancelled
  sellerId    Int?
  seller      Seller?   @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  sellerName  String    // kept even if the seller is deleted later
  shipTo      String?   // the warehouse (3PL) name and address
  wantedBy    DateTime? // when we'd like it at the warehouse
  expectedAt  DateTime? // when the seller says it will arrive
  termsDays   Int       @default(30) // e.g. net 30: pay 30 days after it arrives
  tracking    String?   // tracking or bill of lading number
  notes       String?
  author      String?
  sentAt      DateTime?
  confirmedAt DateTime?
  shippedAt   DateTime?
  receivedAt  DateTime?
  billId      Int?      @unique
  bill        Bill?     @relation(fields: [billId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lines       PurchaseOrderLine[]
}

// One product on a purchase order
model PurchaseOrderLine {
  id              Int            @id @default(autoincrement())
  purchaseOrderId Int
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemId          Int?
  item            InventoryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemName        String         // kept even if the item is deleted later
  unit            String         @default("case")
  cases           Int            // how many we ordered, in the item's unit
  pallets         Int?           // ordered as this many pallets
  unitCost        Float          // the seller's price per case
  receivedCases   Int?           // how many actually arrived
  batch           String?        // batch / lot number on what arrived
}
