generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Submission {
  id           Int      @id @default(autoincrement())
  name         String
  email        String
  phone        String? 
  companyName  String?
  productName  String
  category     String?
  cost         String?
  minimumOrder String?
  city         String?
  county       String?
  notes        String?
  productUrl   String?
  documentsUrl String?
  barcode      String?
  imageUrl     String?
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  trackingId String? @unique

  reviewNotes  ReviewNote[]
  statusEvents StatusEvent[]
  sales        Sale[]
  documents    Document[]
}
model ReviewNote {
  id           Int        @id @default(autoincrement())
  content      String
  author       String     @default("Admin")   // ← add this line
  createdAt    DateTime   @default(now())

  submissionId Int
  submission   Submission @relation(fields: [submissionId], references: [id])
}
model StatusEvent {
  id           Int        @id @default(autoincrement())
  fromStatus   String
  toStatus     String
  createdAt    DateTime   @default(now())

  submissionId Int
  submission   Submission @relation(fields: [submissionId], references: [id])
}
model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  image       String?
  origin      String
  createdAt   DateTime @default(now())
}
model Sale {
  id           Int        @id @default(autoincrement())
  quantity     Int
  revenue      Float
  note         String?
  createdAt    DateTime   @default(now())

  submissionId Int
  submission   Submission @relation(fields: [submissionId], references: [id])
}

// Paperwork a seller sends us: food license, FDA registration, insurance, etc.
// The kinds of documents are listed in lib/documents.ts.
model Document {
  id           Int        @id @default(autoincrement())
  type         String
  url          String?
  fileName     String?
  value        String?
  uploadedBy   String     @default("seller")
  createdAt    DateTime   @default(now())

  submissionId Int
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

// Every admin login attempt, used to pause logins after too many wrong passwords
model LoginAttempt {
  id        Int      @id @default(autoincrement())
  username  String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([createdAt])
}
